# Metal support without add_subdirectory(zest): include ZestVulkan.cmake first if Vulkan is built, set ZEST_ENABLE_METAL, include this, call zest_metal_implementation_source(<target> <file>)
# Then add the include folders ${ZEST_METAL_SPIRV_CROSS_INCLUDE_DIR} ${ZEST_METAL_SHADERC_INCLUDE_DIR} and link ${ZEST_METAL_FRAMEWORKS} ${ZEST_METAL_SPIRV_CROSS_LIBRARIES} ${ZEST_METAL_SHADERC_LIBRARY}.
# The shaderc ones are empty when Vulkan's shaderc serves Metal.

# Variables are set in the including scope on every include, the function only on the first
get_property(_zest_metal_included GLOBAL PROPERTY ZEST_METAL_MODULE_INCLUDED)
set_property(GLOBAL PROPERTY ZEST_METAL_MODULE_INCLUDED TRUE)

# Guarded so a host's set() before the include isn't discarded by option() under old policies.
# On by default on Apple
if(NOT DEFINED ZEST_ENABLE_METAL)
    if(APPLE)
        set(_zest_metal_default ON)
    else()
        set(_zest_metal_default OFF)
    endif()
    option(ZEST_ENABLE_METAL "Enable the Metal backend (Apple only)" ${_zest_metal_default})
endif()

set(ZEST_METAL_ENABLED FALSE)
set(ZEST_METAL_SPIRV_CROSS_LIBRARIES "")
set(ZEST_METAL_FRAMEWORKS "")

if(ZEST_ENABLE_METAL)
    if(NOT APPLE)
        message(FATAL_ERROR "ZEST_ENABLE_METAL is only supported on Apple platforms.")
    endif()

    # The backend turns SPIR-V into MSL with SPIRV-Cross's C API, which the Vulkan SDK and Homebrew's spirv-cross ship as static libraries.
    # Each search tries the Vulkan SDK alone when VULKAN_SDK is set, then the default paths with Homebrew's prefix.
    set(_zest_metal_homebrew_prefix "/opt/homebrew")
    if(DEFINED ENV{HOMEBREW_PREFIX})
        set(_zest_metal_homebrew_prefix "$ENV{HOMEBREW_PREFIX}")
    endif()
    set(_zest_metal_install_hint "Install the Vulkan SDK and set VULKAN_SDK to its macOS folder, or run brew install spirv-cross shaderc. Configure with -DZEST_ENABLE_METAL=OFF to build without Metal.")

    if(DEFINED ENV{VULKAN_SDK})
        find_path(ZEST_METAL_SPIRV_CROSS_INCLUDE_DIR NAMES spirv_cross/spirv_cross_c.h HINTS "$ENV{VULKAN_SDK}" PATH_SUFFIXES include NO_DEFAULT_PATH)
    endif()
    find_path(ZEST_METAL_SPIRV_CROSS_INCLUDE_DIR NAMES spirv_cross/spirv_cross_c.h PATHS "${_zest_metal_homebrew_prefix}" PATH_SUFFIXES include)
    if(NOT ZEST_METAL_SPIRV_CROSS_INCLUDE_DIR)
        message(FATAL_ERROR "Couldn't find spirv_cross/spirv_cross_c.h. ${_zest_metal_install_hint}")
    endif()

    # The C wrapper references every SPIRV-Cross backend, so all of these are needed, in this order
    foreach(_zest_metal_component c msl hlsl cpp reflect glsl core)
        if(DEFINED ENV{VULKAN_SDK})
            find_library(ZEST_METAL_SPIRV_CROSS_LIBRARY_${_zest_metal_component} NAMES spirv-cross-${_zest_metal_component} HINTS "$ENV{VULKAN_SDK}" PATH_SUFFIXES lib NO_DEFAULT_PATH)
        endif()
        find_library(ZEST_METAL_SPIRV_CROSS_LIBRARY_${_zest_metal_component} NAMES spirv-cross-${_zest_metal_component} PATHS "${_zest_metal_homebrew_prefix}" PATH_SUFFIXES lib)
        if(NOT ZEST_METAL_SPIRV_CROSS_LIBRARY_${_zest_metal_component})
            message(FATAL_ERROR "Couldn't find the spirv-cross-${_zest_metal_component} library. ${_zest_metal_install_hint}")
        endif()
        list(APPEND ZEST_METAL_SPIRV_CROSS_LIBRARIES "${ZEST_METAL_SPIRV_CROSS_LIBRARY_${_zest_metal_component}}")
    endforeach()

    # Vulkan's shaderc serves Metal too when Vulkan is built, so include ZestVulkan.cmake first
    if(ZEST_VULKAN_SHADERC_FOUND)
        set(ZEST_METAL_SHADERC_INCLUDE_DIR "")
        set(ZEST_METAL_SHADERC_LIBRARY "")
        set(_zest_metal_shaderc_source "the Vulkan build")
    else()
        unset(ZEST_METAL_SHADERC_INCLUDE_DIR)
        unset(ZEST_METAL_SHADERC_LIBRARY)
        if(DEFINED ENV{VULKAN_SDK})
            find_path(ZEST_METAL_SHADERC_INCLUDE_DIR NAMES shaderc/shaderc.h HINTS "$ENV{VULKAN_SDK}" PATH_SUFFIXES include NO_DEFAULT_PATH)
            find_library(ZEST_METAL_SHADERC_LIBRARY NAMES shaderc_combined HINTS "$ENV{VULKAN_SDK}" PATH_SUFFIXES lib NO_DEFAULT_PATH)
        endif()
        find_path(ZEST_METAL_SHADERC_INCLUDE_DIR NAMES shaderc/shaderc.h PATHS "${_zest_metal_homebrew_prefix}" PATH_SUFFIXES include)
        if(NOT ZEST_METAL_SHADERC_INCLUDE_DIR)
            message(FATAL_ERROR "Couldn't find shaderc/shaderc.h. ${_zest_metal_install_hint}")
        endif()
        find_library(ZEST_METAL_SHADERC_LIBRARY NAMES shaderc_combined PATHS "${_zest_metal_homebrew_prefix}" PATH_SUFFIXES lib)
        if(NOT ZEST_METAL_SHADERC_LIBRARY)
            message(FATAL_ERROR "Couldn't find the shaderc_combined library. ${_zest_metal_install_hint}")
        endif()
        set(_zest_metal_shaderc_source "${ZEST_METAL_SHADERC_INCLUDE_DIR}")
    endif()

    set(ZEST_METAL_FRAMEWORKS "-framework Metal" "-framework QuartzCore" "-framework Foundation")

    # The backend needs macOS 15 for residency sets
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET OR CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 15.0)
        set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
    endif()

    # Homebrew builds its bottles for the macOS it runs on, so linking them raises the deployment target to that macOS
    if(ZEST_VULKAN_SHADERC_FOUND)
        set(_zest_metal_shaderc_paths "${Vulkan_shaderc_combined_LIBRARY}" ${SHADERC_LIBRARY_DIRS})
    else()
        set(_zest_metal_shaderc_paths "${ZEST_METAL_SHADERC_LIBRARY}")
    endif()
    set(_zest_metal_homebrew_built "")
    string(FIND "${ZEST_METAL_SPIRV_CROSS_LIBRARY_c}" "${_zest_metal_homebrew_prefix}/" _zest_metal_position)
    if(_zest_metal_position EQUAL 0)
        list(APPEND _zest_metal_homebrew_built "SPIRV-Cross")
    endif()
    foreach(_zest_metal_shaderc_path IN LISTS _zest_metal_shaderc_paths)
        string(FIND "${_zest_metal_shaderc_path}" "${_zest_metal_homebrew_prefix}/" _zest_metal_position)
        if(_zest_metal_position EQUAL 0)
            list(APPEND _zest_metal_homebrew_built "shaderc")
            break()
        endif()
    endforeach()
    set(_zest_metal_deployment_reason "")
    if(_zest_metal_homebrew_built)
        execute_process(COMMAND sw_vers -productVersion OUTPUT_VARIABLE _zest_metal_macos_version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(REGEX MATCH "^[0-9]+" _zest_metal_macos_major "${_zest_metal_macos_version}")
        if(_zest_metal_macos_major AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "${_zest_metal_macos_major}.0")
            set(CMAKE_OSX_DEPLOYMENT_TARGET "${_zest_metal_macos_major}.0")
            list(JOIN _zest_metal_homebrew_built " and " _zest_metal_homebrew_built_text)
            set(_zest_metal_deployment_reason ", as Homebrew built ${_zest_metal_homebrew_built_text} for this macOS. Use the Vulkan SDK's libraries to target macOS 15.")
        endif()
    endif()

    set(ZEST_METAL_ENABLED TRUE)
    message(STATUS "Metal support enabled: SPIRV-Cross from ${ZEST_METAL_SPIRV_CROSS_INCLUDE_DIR}, shaderc from ${_zest_metal_shaderc_source}, deployment target ${CMAKE_OSX_DEPLOYMENT_TARGET}${_zest_metal_deployment_reason}")
endif()

if(NOT _zest_metal_included)
    # Compile the file that defines ZEST_METAL_IMPLEMENTATION as Objective-C or Objective-C++ without ARC, which zest_metal.h needs
    function(zest_metal_implementation_source TARGET_NAME SOURCE_FILE)
        if(NOT ZEST_METAL_ENABLED)
            return()
        endif()
        get_filename_component(_zest_metal_extension "${SOURCE_FILE}" EXT)
        if(_zest_metal_extension STREQUAL ".c")
            set(_zest_metal_flags " -x objective-c -fno-objc-arc")
        else()
            set(_zest_metal_flags " -x objective-c++ -fno-objc-arc")
        endif()
        # A source property only reaches a target defined in another directory when that directory is named
        if(CMAKE_VERSION VERSION_LESS 3.18)
            set_property(SOURCE "${SOURCE_FILE}" APPEND_STRING PROPERTY COMPILE_FLAGS "${_zest_metal_flags}")
        else()
            set_property(SOURCE "${SOURCE_FILE}" TARGET_DIRECTORY ${TARGET_NAME} APPEND_STRING PROPERTY COMPILE_FLAGS "${_zest_metal_flags}")
        endif()
    endfunction()
endif()
