# Vulkan support without add_subdirectory(zest): set ZEST_ENABLE_VULKAN, include this, link ${ZEST_VULKAN_LIBRARIES}

# Guarded so a host's set() before the include isn't discarded by set(CACHE) under old policies.
# AUTO builds Vulkan when CMake finds it, so a D3D12 or Metal build needs no Vulkan SDK
if(NOT DEFINED ZEST_ENABLE_VULKAN)
    set(ZEST_ENABLE_VULKAN AUTO CACHE STRING "Build the Vulkan backend: AUTO when CMake finds Vulkan, ON to require it, OFF to leave it out")
    set_property(CACHE ZEST_ENABLE_VULKAN PROPERTY STRINGS AUTO ON OFF)
endif()

set(ZEST_VULKAN_ENABLED FALSE)
set(ZEST_VULKAN_LIBRARIES "")
set(ZEST_VULKAN_INCLUDE_DIRS "")
set(ZEST_VULKAN_LIBRARY_DIRS "")
set(ZEST_VULKAN_DEFINITIONS "")
set(ZEST_VULKAN_SHADERC_FOUND FALSE)

string(TOUPPER "${ZEST_ENABLE_VULKAN}" _zest_vulkan_mode)
if(_zest_vulkan_mode STREQUAL "AUTO")
    set(_zest_vulkan_wanted TRUE)
    set(_zest_vulkan_required FALSE)
elseif(ZEST_ENABLE_VULKAN)
    set(_zest_vulkan_wanted TRUE)
    set(_zest_vulkan_required TRUE)
else()
    set(_zest_vulkan_wanted FALSE)
    set(_zest_vulkan_required FALSE)
endif()

if(_zest_vulkan_wanted)
    find_package(Vulkan COMPONENTS shaderc_combined)

    # A Vulkan library copied into libs/vulkan, which git ignores. Not Vulkan_LIBRARY, which FindVulkan leaves set when it rejects an install.
    if(WIN32 AND NOT Vulkan_FOUND)
        find_library(ZEST_VULKAN_BUNDLED_LIBRARY NAMES vulkan-1 vulkan PATHS ${CMAKE_CURRENT_LIST_DIR}/../libs/vulkan NO_DEFAULT_PATH)
        if(ZEST_VULKAN_BUNDLED_LIBRARY)
            set(Vulkan_LIBRARY "${ZEST_VULKAN_BUNDLED_LIBRARY}")
            set(Vulkan_FOUND ON)
            message("Using bundled Vulkan library version")
        endif()
    endif()

    if(NOT Vulkan_FOUND)
        if(_zest_vulkan_required)
            message(FATAL_ERROR "ZEST_ENABLE_VULKAN is ON but CMake couldn't find Vulkan. Install the Vulkan SDK, or configure with -DZEST_ENABLE_VULKAN=AUTO to build without it.")
        endif()
        message(STATUS "Vulkan not found, so the Vulkan backend isn't built. Install the Vulkan SDK to build it.")
    endif()
endif()

if(_zest_vulkan_wanted AND Vulkan_FOUND)
    set(ZEST_VULKAN_INCLUDE_DIRS ${Vulkan_INCLUDE_DIRS})
    if(MSVC)
        # The Vulkan SDK's shaderc is MSVC only. For MinGW, use MSYS2's mingw-w64-x86_64-shaderc package
        set(ZEST_VULKAN_LIBRARIES Vulkan::Vulkan Vulkan::shaderc_combined)
        set(ZEST_VULKAN_SHADERC_FOUND TRUE)
    else()
        set(_zest_vulkan_frameworks "")
        if(APPLE)
            set(_zest_vulkan_frameworks "-framework AppKit" "-framework QuartzCore")
        endif()

        # On Linux, shaderc_combined from system packages needs its transitive dependencies linked explicitly.
        # When using the Vulkan SDK's bundled shaderc_combined (a fully static archive), these are not needed.
        set(_zest_vulkan_shaderc_extra_libraries "")
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set(_zest_vulkan_shaderc_transitive_libraries glslang SPIRV glslang-default-resource-limits SPIRV-Tools-opt SPIRV-Tools)
            set(_zest_vulkan_missing_shaderc_libraries "")
            foreach(_zest_vulkan_library IN LISTS _zest_vulkan_shaderc_transitive_libraries)
                find_library(_zest_vulkan_found_${_zest_vulkan_library} NAMES ${_zest_vulkan_library})
                if(NOT _zest_vulkan_found_${_zest_vulkan_library})
                    list(APPEND _zest_vulkan_missing_shaderc_libraries ${_zest_vulkan_library})
                endif()
            endforeach()
            if(_zest_vulkan_missing_shaderc_libraries)
                list(JOIN _zest_vulkan_missing_shaderc_libraries ", " _zest_vulkan_missing_shaderc_libraries_text)
                message(WARNING "shaderc dependencies not found: ${_zest_vulkan_missing_shaderc_libraries_text}. glslang and SPIRV-Tools will not be linked, so a system shaderc_combined will fail to link. Ignore this if shaderc_combined comes from the Vulkan SDK.")
            else()
                set(_zest_vulkan_shaderc_extra_libraries ${_zest_vulkan_shaderc_transitive_libraries})
            endif()
        endif()

        # Try Vulkan SDK's shaderc first (works on macOS and Linux with Vulkan SDK)
        if(TARGET Vulkan::shaderc_combined)
            set(ZEST_VULKAN_LIBRARIES Vulkan::Vulkan Vulkan::shaderc_combined ${_zest_vulkan_shaderc_extra_libraries} ${_zest_vulkan_frameworks})
            set(ZEST_VULKAN_SHADERC_FOUND TRUE)
        else()
            # Fallback to pkg-config for shaderc
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(SHADERC QUIET shaderc)
            endif()

            if(SHADERC_FOUND)
                set(ZEST_VULKAN_LIBRARIES Vulkan::Vulkan ${SHADERC_LIBRARIES} ${_zest_vulkan_shaderc_extra_libraries} ${_zest_vulkan_frameworks})
                list(APPEND ZEST_VULKAN_INCLUDE_DIRS ${SHADERC_INCLUDE_DIRS})
                set(ZEST_VULKAN_LIBRARY_DIRS ${SHADERC_LIBRARY_DIRS})
                set(ZEST_VULKAN_SHADERC_FOUND TRUE)
            else()
                message(WARNING "shaderc not found for non-MSVC build. Runtime shader compilation will not be available.")
                set(ZEST_VULKAN_LIBRARIES Vulkan::Vulkan ${_zest_vulkan_frameworks})
                set(ZEST_VULKAN_DEFINITIONS ZEST_NO_SHADERC)
            endif()
        endif()
    endif()

    set(ZEST_VULKAN_ENABLED TRUE)
    message(STATUS "Vulkan support enabled: ${Vulkan_LIBRARY}")
endif()
